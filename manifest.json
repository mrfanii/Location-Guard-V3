{
  "name": "Location Guard (V3)",
  "manifest_version": 3,
  "version": "3.1.1",
  "action": {
    "default_icon": {
      "128": "images/pin_128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Location Guard (V3)"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "description": "Hide your geographic location from websites.",
  "homepage_url": "https://github.com/mrfanii/Location-Guard-V3",
  "icons": {
    "128": "images/pin_128.png"
  },
  "options_ui": {
    "open_in_tab": true,
    "page": "options.html"
  },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/content/main-world.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["js/common.js", "js/content/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "ISOLATED"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["js/content/statistics.js"],
      "run_at": "document_start"
    }
  ]
}
